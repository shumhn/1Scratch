# Browser-visible RPC. This app targets Solana devnet.
NEXT_PUBLIC_BASE_RPC=https://rpc.magicblock.app/devnet

# Server-side faucet RPC; optional when the faucet is disabled.
BASE_RPC=https://rpc.magicblock.app/devnet

# Optional server-only devnet mint authority, supplied locally or through your
# hosting provider's secret store. Leave empty to disable the faucet.
# Never prefix this variable with NEXT_PUBLIC_ or commit its actual value.
FAUCET_KEYPAIR=

# Production faucet stays disabled by default.
FAUCET_PUBLIC_ENABLED=0
