# Example values for environment variables exported in the keeper's shell.
# The keeper does not automatically load this file.
# Devnet RPC that submits set_price transactions:
RPC_URL=https://rpc.magicblock.app/devnet
# Path to the keeper keypair (must equal House.keeper, set at initialize_house):
# If overriding the default, use an absolute path to the authorized keeper.
# KEEPER_KEYPAIR=/absolute/path/to/keeper-keypair.json
# Price refresh cycle:
CYCLE_MS=30000
# Optional demo mode only: publish configured static prices if live quotes fail.
# Leave unset for the public app; a failed quote should not look fresh.
# ALLOW_STATIC_PRICE_FALLBACK=1
# Optional upgrade: Pyth Pro (former Lazer) key for direct stock feeds.
# Jupiter public quotes are the default and need no key.
# PYTH_PRO_API_KEY=
